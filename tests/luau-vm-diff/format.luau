-- string.format
print(string.format("%d %i %5d %-5d| %05d %+d % d", 42, 42, 42, 42, 42, 42, 42))
print(string.format("%x %X %#x %o %c%c", 255, 255, 255, 8, 72, 105))
print(string.format("%f %.2f %10.3f %-10.1f| %e %.3E", 3.14159, 3.14159, 3.14159, 3.14159, 12345.678, 0.000123))
print(string.format("%g %g %g %g %.3g %g", 100000, 1000000, 1e-5, 0.0001, 3.14159, 2^53))
print(string.format("%s %s %s %s", "str", 12, 1.5, nil))
print(string.format("%10s|%-10s|%.2s", "right", "left", "truncate"))
print(string.format("%5.1s|", "abc"))
print(string.format("%%"), string.format("no directives"))
print(string.format("%s", setmetatable({}, {__tostring = function() return "custom" end})))
print(string.format("%d", 3.0), pcall(string.format, "%d", 3.5))
print(string.format("%d", -0), string.format("%d", 2^31), string.format("%d", -2^53))
print(string.format("%.0f %.0f %.0f", 0.5, 1.5, 2.5))
print(string.format("%5.2f%%", 99.555))
print(string.format("%q", 1/3), string.format("%q", 10), string.format("%q", math.huge), string.format("%q", -math.huge))
print(string.format("%*d|", 6, 42))
print(pcall(string.format, "%", 1))
print(pcall(string.format, "%d"))
print(pcall(string.format, "%y", 1))
print(pcall(string.format, "%d", "x"))
print(pcall(string.format, "%10.123f", 1))
print(string.format("%x", -1 % 2^32), string.format("%i", 7.0))
print(string.format("%.14g", 0.1), string.format("%.17g", 0.1), string.format("%a" == nil))
print(string.format("%s %s", 1e100, -1e-100), string.format("[%c]", 0) == "[\0]")
print(string.format("%-+6d|%+.3d|% 05d", 7, 7, 7))
print(#string.format("%099d", 1), #string.format("%.99f", 1))
return string.format("%d-%s", 1, "x")
