[
  {
    "name": "composition-membership-card",
    "font": true,
    "html": "<article id='card'><p id='eyebrow'>MEMBERSHIP</p><h2 id='title'>Make room for more.</h2><p id='description'>Your favorite tools, together in one simple plan.</p><div id='price'><p id='amount'>$12</p><p id='period'>per month</p></div><div id='button'>Explore membership</div><p id='note'>Cancel anytime.</p></article>",
    "css": "#card {width:100%;padding:16px;gap:8px;font-family:Inter;background-color:hsl(240 30% 96%);color:midnightblue;border-radius:16px} #eyebrow {font-size:12px;line-height:18px;color:slateblue} #title {font-size:24px;line-height:32px} #description {font-size:14px;line-height:20px;color:hsl(240 15% 40%)} #price {flex-direction:row;gap:8px;align-items:center} #amount {font-size:28px;line-height:36px} #period {font-size:12px;line-height:18px;color:slategray} #button {padding:10px;background-color:rebeccapurple;color:white;text-align:center;border-radius:8px;font-size:14px;line-height:20px} #note {font-size:12px;line-height:18px;text-align:center;color:slategray}"
  },
  {
    "name": "composition-typography-metrics",
    "font": true,
    "html": "<div id='specimen'><p id='s12' style='font-size:12px;line-height:18px'>Text size 12</p><p id='s14' style='font-size:14px;line-height:20px'>Text size 14</p><p id='s16' style='font-size:16px;line-height:24px'>Text size 16</p><p id='s20' style='font-size:20px;line-height:28px'>Text size 20</p><p id='s22' style='font-size:22px;line-height:30px'>Text size 22</p><p id='s24' style='font-size:24px;line-height:32px'>Text size 24</p><p id='s28' style='font-size:28px;line-height:36px'>Text size 28</p></div>",
    "css": "#specimen {width:100%;padding:12px;gap:4px;font-family:Inter;background-color:aliceblue;color:midnightblue} #specimen p {background-color:lavender}"
  },
