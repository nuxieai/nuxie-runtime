--! attacks: Text:append of 1 MiB runs in a loop past the host budget; expect: ok; within: 30s
-- Font: tests/web_scripting/stress/text/label_font.ttf from the pinned rive-runtime, hex-encoded.
local FONT_HEX = ""
local function fontBytes()
  local n = #FONT_HEX // 2
  local b = buffer.create(n)
  for i = 0, n - 1 do
    buffer.writeu8(b, i, tonumber(string.sub(FONT_HEX, 2 * i + 1, 2 * i + 2), 16))
  end
  return b
end
local font = Font.decode(fontBytes())
assert(font, "fixture font did not decode")
local text = Text.new()
local chunk = string.rep("x", 1024 * 1024)
local ok, err
for _ = 1, 200 do
  ok, err = pcall(function() text:append(chunk, {font = font, size = 12}) end)
  if not ok then break end
end
assert(not ok, "200 MiB of text content never hit the budget")
assert(string.find(tostring(err), "host memory budget", 1, true), tostring(err))
-- A failed append leaves the text as it was; clear and reuse.
text:clear()
text:append("ok", {font = font})
assert(text.lineCount == 1)
return {}
