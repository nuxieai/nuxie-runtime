+fn fixture(
+    flags: PathFlags,
+) -> (
+    CoreArena,
+    CoreHandle,
+    CoreHandle,
+    RuntimePathComposerHandle,
+    Rc<Query>,
+) {
+    let arena = CoreArena::default();
+    let shape = arena.insert(Shape::default());
+    shape
+        .with_downcast_mut::<Shape, _>(|shape| {
+            shape.add_flags(flags | PathFlags::NEVER_DEFER_UPDATE)
+        })
+        .unwrap();
+    let query = Rc::new(Query::default());
+    let mut inner = PointsPath::default();
+    for (x, y) in [(0.0, 0.0), (4.0, 0.0), (0.0, 3.0)] {
+        let mut vertex = StraightVertex::default();
+        vertex.set_x(x);
+        vertex.set_y(y);
+        inner.add_runtime_straight_vertex(Rc::new(RefCell::new(vertex)));
+    }
+    inner.as_path_mut().unwrap().update_after_transform_super(
+        ComponentDirt::PATH,
+        true,
+        Some(false),
+    );
+    assert!(!inner.raw_path().empty());
+    let path = arena.insert(QueryPath {
+        inner,
+        query: query.clone(),
+    });
+    let composer = shape
+        .with_downcast_mut::<Shape, _>(|owner| {
+            owner.add_path(path.clone());
+            owner.path_composer_mut().clone()
+        })
+        .unwrap();
+    composer.bind_shape(shape.clone());
+    (arena, shape, path, composer, query)
+}
