{
  "name": "@nuxie/html-to-riv",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test --project=native",
    "test:geometry": "playwright test --project=geometry",
    "build": "bash validation/build-wasm.sh",
    "test:js": "node --test tests/javascript.test.mjs tests/gradient-parity.test.mjs",
    "typecheck": "tsc --noEmit --strict --module nodenext --target es2022 tests/types.mts",
    "test:report": "node --test tests/gallery.test.mjs",
    "test:transform-reference": "node validation/width-kana-reference.mjs",
    "test:underline-reference": "node validation/underline-reference.mjs",
    "test:strikethrough-reference": "node validation/strikethrough-reference.mjs && node validation/strikethrough-paint-reference.mjs && node validation/strikethrough-phase-reference.mjs",
    "test:underline-runtime": "node validation/underline-runtime-control.mjs",
    "prepack": "npm run build",
    "test:package": "node --test tests/package.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "typescript": "5.9.3"
  },
  "version": "0.1.0",
  "description": "HTML/CSS authoring compiler for Nuxie Rive scenes",
  "files": [
    "js/",
    "dist/html-to-riv.wasm",
    "src/reset.css",
    "README.md",
    "SUPPORT.md",
    "VALIDATION.md"
  ],
  "exports": {
    ".": {
      "types": "./js/index.d.mts",
      "import": "./js/index.mjs"
    },
    "./compiler.wasm": "./dist/html-to-riv.wasm",
    "./reset.css": "./src/reset.css"
  }
}
