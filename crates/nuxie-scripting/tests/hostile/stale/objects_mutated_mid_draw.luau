local function decodeFont()
  local bytes = (string.gsub(FONT_HEX, "%x%x", function(h) return string.char(tonumber(h, 16)) end))
  return Font.decode(buffer.fromstring(bytes))
end
local font = decodeFont()
return function()
  return {
    init = function(self)
      self.path = Path.new()
      self.paint = Paint.with({ color = 0xff336699, style = "stroke", thickness = 2 })
      self.text = Text.new()
      self.text:append("draw \u{1F600}", { font = font })
      return true
    end,
    draw = function(self, renderer)
      local path, paint, text = self.path, self.paint, self.text
      path:moveTo(Vector.xy(0, 0))
      path:lineTo(Vector.xy(20, 20))
      renderer:drawPath(path, paint)
      -- Mutate everything the renderer just consumed, then draw again.
      path:reset()
      paint.gradient = Gradient.linear(Vector.xy(0, 0), Vector.xy(5, 0), { { position = 0, color = 0xff000000 }, { position = 1, color = 0xffffffff } })
      paint.style = "fill"
      renderer:drawPath(path, paint)
      paint.gradient = nil
      renderer:clipPath(path)
      for i = 1, 8 do path:add(path) end
      renderer:drawPath(path, paint)
      -- Text drawn, cleared, drawn empty, refilled, drawn with a mutated paint.
      text:draw(renderer)
      local line = text:line(1)
      text:clear()
      text:draw(renderer, paint)
      text:append("again", { font = font, paint = paint })
      paint.thickness = 50
      text:draw(renderer, paint)
      assert(not pcall(function() return line.width end))
      -- A glyph path made into a Path and drawn after the text changed.
      local glyphPath = text:line(1):glyph(1):path()
      text:append("more", { font = font })
      renderer:drawPath(glyphPath, paint)
      -- A Path drawn while its only other reference is dropped.
      local temp = Path.new()
      temp:moveTo(Vector.xy(1, 1)); temp:lineTo(Vector.xy(2, 2))
      local tempPaint = Paint.new()
      renderer:drawPath(temp, tempPaint)
      temp, tempPaint = nil, nil
      -- Text:draw with a stale renderer from an earlier frame must fail cleanly.
      if self.oldRenderer then
        assert(not pcall(function() text:draw(self.oldRenderer) end))
      end
      self.oldRenderer = renderer
    end,
    advance = function(self, dt)
      -- Objects drawn last frame are mutated outside any draw.
      self.path:reset()
      self.paint.color = 0xffff0000
      self.text:clear()
      self.text:append("next frame", { font = font })
      return true
    end,
  }
end
