capture_tool=upstream-gms
build_command=DEPENDENCIES=<deps> PREMAKE_PATH=<build-tree>/build premake5 gmake2 --config=release --out=out/pin-gms --with_rive_canvas --with_rive_text --with_rive_layout (from tests); make -C out/pin-gms -j12 CC=/usr/bin/clang CXX=/usr/bin/clang++ gms
build_note=--with_rive_layout added because src/text/text_input.cpp at this revision calls LayoutComponent::hugsContentWidth, which is declared only under WITH_RIVE_LAYOUT; without it rive does not compile. <deps> holds the pinned checkout's existing dependency clones, glfw 3.4 (github.com/glfw/glfw tag 3.4, commit 7b6aead9fb88b3623e3b3725ebb42670cbe4c579) and ply 3.11 from PyPI at dabeaz_ply_3.11
capture_command=env -u MTL_SHADER_VALIDATION MTL_DEBUG_LAYER=1 <evidence>/gms-adapted --backend metal --headless --match stroke_position --output <evidence>/adapted -p1 --verbose
