-- math library
print(math.pi, math.huge, -math.huge)
print(math.abs(-0.0), math.floor(-0.5), math.ceil(-0.5), math.floor(3), math.ceil(3.0000001))
print(math.sqrt(2), math.sqrt(-1) ~= math.sqrt(-1), math.exp(1), math.log(10), math.log(8, 2), math.log(100, 10), math.log10(1000))
print(math.sin(1), math.cos(1), math.tan(1), math.asin(0.5), math.acos(0.5), math.atan(1), math.atan2(1, -1))
print(math.sinh(1), math.cosh(1), math.tanh(1), math.deg(math.pi), math.rad(180))
print(math.pow(2, 10), math.fmod(7, 3), math.fmod(-7, 3), math.fmod(7, -3), pcall(math.fmod, 1, 0))
print(math.modf(3.7), math.modf(-3.7), math.modf(5), math.modf(math.huge))
print(math.min(3, 1, 2), math.max(3, 1, 2), math.min(-0.0, 0.0), math.max(0/0, 1) ~= nil)
