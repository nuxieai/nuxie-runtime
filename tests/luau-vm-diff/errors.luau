-- error values, levels, pcall, xpcall, runtime error text
print(pcall(error, "msg"))
print(pcall(error, "msg", 0))
print(pcall(function() error("lvl1") end))
print(pcall(function() error("lvl2", 2) end))
print(pcall(function() error() end))
print(pcall(function() error(nil) end))
print(pcall(function() error(42) end))
local ok, e = pcall(function() error({code = 7}) end)
print(ok, type(e), e.code)
print(pcall(function() error(setmetatable({}, {__tostring = function() return "obj" end})) end))
print(xpcall(function() error("boom") end, function(m) return "handled: " .. m end))
print(xpcall(function(a, b) return a + b end, print, 2, 3))
print(xpcall(function() error("x") end, function() error("again") end))
print(pcall(pcall))
print(pcall(xpcall))
print(select("#", pcall(function() return end)))
local function thrower(n) if n == 0 then error("deep") end thrower(n - 1) end
print(pcall(thrower, 50))
print(pcall(assert, false))
print(pcall(assert, nil, "custom"))
print(pcall(assert, 1 == 1, "unused"))
print(pcall(assert, false, {1}))
print(select("#", assert(1, 2, 3)))
local t = nil
print(pcall(function() return t.field end))
print(pcall((function() local up = t; return function() return up.x end end)()))
print(pcall(function() return ("x").y.z end))
print(pcall(function() return #nil end))
print(pcall(function() return #5 end))
print(pcall(function() local a = {} ; a.b.c = 1 end))
print(pcall(string.rep))
print(pcall(string.sub))
print(pcall(setmetatable, 1, {}))
print(pcall(rawset, {}, nil, 1))
print(pcall(ipairs))
print(pcall(next, {}, "nokey"))
print(pcall(tonumber, "10", 99))
local nested_ok, nested = pcall(function()
    local ok2, inner = pcall(error, "inner")
    error("outer:" .. inner)
end)
print(nested_ok, nested)
error("escapes to host")
