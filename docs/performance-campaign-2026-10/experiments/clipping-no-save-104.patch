+#[test]
+fn empty_effect_is_not_replaced_with_raw_but_a_second_plain_fill_needs_raw() {
+    let arena = CoreArena::default();
+    let shape = source(&arena);
+    shape.with(|s| {
+        s.as_shape()
+            .unwrap()
+            .with_path_mut(ShapePaintPathKind::World, |p| {
+                p.mutable_raw_path().move_to(2.0, 3.0);
+                p.mutable_raw_path().line_to(4.0, 5.0);
+            })
+    });
+    fill_with_effect(
+        &arena,
+        &shape,
+        || {},
+        Some(Rc::new(RefCell::new(ShapePaintPath::new(true)))),
+    );
+    let clip = clip(&arena, &shape);
+    component_update_handle(&clip, ComponentDirt::PATH);
+    assert!(points(&clip).is_empty());
+    assert!(
+        clip.with_downcast::<ClippingShape, _>(|c| c.clip_path)
+            .unwrap()
+    );
+    let stroke = arena.insert(Stroke::default());
+    shape.with_mut(|s| s.as_shape_mut().unwrap().paint_container.add_paint(stroke));
+    component_update_handle(&clip, ComponentDirt::PATH);
+    assert!(
+        points(&clip).is_empty(),
+        "stroke centerlines never become filled clip geometry"
+    );
+    let plain = arena.insert(Fill::default());
+    shape.with_mut(|s| s.as_shape_mut().unwrap().paint_container.add_paint(plain));
+    component_update_handle(&clip, ComponentDirt::PATH);
+    assert_eq!(
+        points(&clip),
+        vec![Vec2D::new(2.0, 3.0), Vec2D::new(4.0, 5.0)]
+    );
+}
