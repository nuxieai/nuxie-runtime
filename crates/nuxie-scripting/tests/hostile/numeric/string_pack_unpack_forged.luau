--! attacks: string.pack/unpack with i0/i17/i16, forged s1/s4 length prefixes, huge c and ! sizes, huge repeat counts and out-of-range init positions; expect: ok; within: 20s
local LOG = {}
local function try(name, f, ...)
  local r = table.pack(pcall(f, ...))
  local err = tostring(r[2])
  assert(not string.find(err, "rust panic", 1, true), name .. ": " .. err)
  table.insert(LOG, name .. " => " .. tostring(r[1]) .. " " .. string.sub(err, 1, 120))
  return r[1], r[2], r
end
local function refused(name, f, ...)
  local ok, err = try(name, f, ...)
  assert(not ok, name .. ": accepted")
  return tostring(err)
end
local nan, inf = 0 / 0, math.huge
refused("pack i0", string.pack, "i0", 1)
refused("pack i17", string.pack, "i17", 1)
refused("pack i99999999999", string.pack, "i99999999999", 1)
try("pack i16", string.pack, "i16", -1)
try("unpack i16 sign extend", string.unpack, "i16", string.rep("\255", 16))
try("unpack i16 overflow", string.unpack, "i16", string.rep("\255", 8) .. string.rep("\1", 8))
try("unpack I9 overflow", string.unpack, "I9", string.rep("\255", 9))
refused("unpack s4 forged", string.unpack, "s4", "\255\255\255\127abc")
refused("unpack s4 forged 2^32-1", string.unpack, "s4", "\255\255\255\255abc")
refused("unpack s1 forged", string.unpack, "s1", "\200abc")
refused("unpack s8 forged", string.unpack, "s8", "\255\255\255\255\255\255\255\127abc")
refused("unpack z unterminated", string.unpack, "z", "abc")
refused("pack s1 too long", string.pack, "s1", string.rep("x", 256))
try("pack c huge", string.pack, "c2147483647", "")
try("pack c 2^40", string.pack, "c1099511627776", "")
refused("unpack c huge", string.unpack, "c2147483647", "abc")
try("pack !huge", string.pack, "!99999999i4", 1)
try("pack Xi16 align", string.pack, "!16 b Xi16", 1)
refused("pack X nothing", string.pack, "X", 1)
refused("unpack init 2^31", string.unpack, "b", "abc", 2 ^ 31)
try("unpack init -2^31", string.unpack, "b", "abc", -(2 ^ 31))
try("unpack init nan", string.unpack, "b", "abc", nan)
try("unpack init len+1", string.unpack, "z", "abc", 4)
-- far more results than the stack takes
local many = string.rep("b", 100000)
try("unpack 100000 results", string.unpack, many, string.rep("\0", 100000))
try("pack 7000 values", string.pack, string.rep("d", 7000), table.unpack(table.create(7000, 1.5)))
try("packsize huge", string.packsize, string.rep("i16", 200000000 // 16 // 1000))
try("packsize overflow", string.packsize, "c2147483647c2147483647")
refused("packsize s", string.packsize, "s4")
try("pack i4 nan", string.pack, "i4", nan)
try("pack i8 2^64", string.pack, "i8", 2 ^ 64)
try("pack f inf", string.pack, "f", inf)
return {}
