  {
    "name": "hsl-boundary-palette",
    "html": "<div id=\"outer\"><div id=\"swatch-hue-zero\"></div><div id=\"swatch-degrees\"></div><div id=\"swatch-gradians\"></div><div id=\"swatch-turns\"></div><div id=\"swatch-radians\"></div><div id=\"swatch-negative-hue\"></div><div id=\"swatch-wrapped-hue\"></div><div id=\"swatch-negative-turn\"></div><div id=\"swatch-legacy-alpha\"></div><div id=\"swatch-slash-alpha\"></div><div id=\"swatch-zero-alpha\"></div><div id=\"swatch-full-alpha\"></div><div id=\"swatch-clamp-alpha-low\"></div><div id=\"swatch-clamp-alpha-high\"></div><div id=\"swatch-clamp-alpha-number-low\"></div><div id=\"swatch-clamp-alpha-number-high\"></div><div id=\"swatch-clamp-saturation-low\"></div><div id=\"swatch-clamp-saturation-high\"></div><div id=\"swatch-clamp-lightness-low\"></div><div id=\"swatch-clamp-lightness-high\"></div><div id=\"swatch-grey\"></div><div id=\"swatch-legacy-degrees\"></div><div id=\"swatch-modern-number-components\"></div><div id=\"swatch-fractional-alpha\"></div></div>",
    "css": "div{display:flex;flex-direction:column;}#outer{width:100%;height:100%;background-color:white;}#swatch-hue-zero{width:100%;height:8px;background-color:hsl(0 100% 50%);}#swatch-degrees{width:100%;height:8px;background-color:hsl(120deg 100% 25%);}#swatch-gradians{width:100%;height:8px;background-color:hsl(200grad 100% 50%);}#swatch-turns{width:100%;height:8px;background-color:hsl(.75turn 100% 50%);}#swatch-radians{width:100%;height:8px;background-color:hsl(3.141592653589793rad 100% 50%);}#swatch-negative-hue{width:100%;height:8px;background-color:hsl(-120 100% 50%);}#swatch-wrapped-hue{width:100%;height:8px;background-color:hsl(840 100% 50%);}#swatch-negative-turn{width:100%;height:8px;background-color:hsl(-.25turn 100% 50%);}#swatch-legacy-alpha{width:100%;height:8px;background-color:hsla(270,50%,40%,0.5);}#swatch-slash-alpha{width:100%;height:8px;background-color:hsl(30 100% 50% / 25%);}#swatch-zero-alpha{width:100%;height:8px;background-color:hsl(0 100% 50% / 0);}#swatch-full-alpha{width:100%;height:8px;background-color:hsl(0 100% 50% / 1);}#swatch-clamp-alpha-low{width:100%;height:8px;background-color:hsl(0 100% 50% / -50%);}#swatch-clamp-alpha-high{width:100%;height:8px;background-color:hsl(0 100% 50% / 150%);}#swatch-clamp-alpha-number-low{width:100%;height:8px;background-color:hsla(120,100%,50%,-1);}#swatch-clamp-alpha-number-high{width:100%;height:8px;background-color:hsla(120,100%,50%,2);}#swatch-clamp-saturation-low{width:100%;height:8px;background-color:hsl(210 -50% 50%);}#swatch-clamp-saturation-high{width:100%;height:8px;background-color:hsl(210 150% 50%);}#swatch-clamp-lightness-low{width:100%;height:8px;background-color:hsl(210 100% -50%);}#swatch-clamp-lightness-high{width:100%;height:8px;background-color:hsl(210 100% 150%);}#swatch-grey{width:100%;height:8px;background-color:hsl(50 0% 50%);}#swatch-legacy-degrees{width:100%;height:8px;background-color:hsl(60deg,100%,50%);}#swatch-modern-number-components{width:100%;height:8px;background-color:hsl(180 100 50);}#swatch-fractional-alpha{width:100%;height:8px;background-color:hsl(240 80% 60% / .333333);}",
