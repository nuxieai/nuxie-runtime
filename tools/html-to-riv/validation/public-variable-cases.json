[
  {
    "name": "variables-inherited-alias-frozen",
    "html": "<div id=\"root\"><div id=\"a\"></div><div id=\"b\"></div></div>",
    "css": "#root{width:180px;height:112px;background:white}#root div{width:120px;height:24px;background:silver}#root{--tone:teal;--alias:var(--tone)}#root #a{--tone:coral;background:var(--alias)}#root #b{background:var(--tone)}",
    "literalCss": "#root{width:180px;height:112px;background:white}#root div{width:120px;height:24px;background:silver}#root #a,#root #b{background:teal}",
    "features": [
      "S09",
      "S10",
      "inherited alias frozen"
    ],
    "expectedPaint": {
      "root": "rgb(255, 255, 255)",
      "a": "rgb(0, 128, 128)",
      "b": "rgb(0, 128, 128)"
    }
  },
