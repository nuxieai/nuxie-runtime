+struct QueryPath {
+    inner: PointsPath,
+    query: Rc<Query>,
+}
+forward_owner!(QueryPath, 65520);
+impl CoreCapabilities for QueryPath {
+    fn as_component(&self) -> Option<&Component> {
+        self.inner.as_component()
+    }
+    fn as_component_mut(&mut self) -> Option<&mut Component> {
+        self.inner.as_component_mut()
+    }
+    fn as_path(&self) -> Option<&Path> {
+        self.inner.as_path()
+    }
+    fn as_path_mut(&mut self) -> Option<&mut Path> {
+        self.inner.as_path_mut()
+    }
+    fn as_points_path(&self) -> Option<&PointsPath> {
+        self.query.run();
+        Some(&self.inner)
+    }
+    fn as_points_path_mut(&mut self) -> Option<&mut PointsPath> {
+        Some(&mut self.inner)
+    }
+}
