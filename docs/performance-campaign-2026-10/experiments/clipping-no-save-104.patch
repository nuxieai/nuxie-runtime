+#[test]
+fn no_save_clip_releases_pending_retirement_after_resource_callback_and_unwind() {
+    for panic_at_clip in [false, true] {
+        let arena = CoreArena::default();
+        let clip = arena.insert(ClippingShape::default());
+        let root = hydrate_clip(&arena, &clip);
+        let arena_owner = Rc::new(RefCell::new(Some(arena)));
+        let drop_owner = arena_owner.clone();
+        let callback_clip = clip.clone();
+        let mut renderer = ClipCallback {
+            callback: Box::new(move || {
+                drop(drop_owner.borrow_mut().take());
+                assert!(
+                    callback_clip.is_alive(),
+                    "active inline resource keeps payload until callback exits"
+                );
+                if panic_at_clip {
+                    panic!("clip callback unwind");
+                }
+            }),
+            clips: 0,
+        };
+        let mut start = ClippingShapeStart {
+            clipping_shape: Some(clip.clone()),
+        };
+        let result = catch_unwind(AssertUnwindSafe(|| start.draw(&mut renderer, false)));
+        assert_eq!(result.is_err(), panic_at_clip);
+        assert_eq!(renderer.clips, 1);
+        assert!(!clip.is_alive());
+        assert!(!root.is_alive());
+        assert!(clip.with_mut(|_| ()).is_none());
+        start.draw(&mut renderer, false);
+        assert_eq!(renderer.clips, 1, "retired identity cannot draw again");
+    }
+}
