+// Only the actual native source gets released, fresh membership reads. A
+// custom projection keeps its existing one-query snapshot and checked scopes.
+enum ClipPaints<'a> {
+    Native {
+        owner: &'a CoreHandle,
+        count: usize,
+        index: usize,
+        first: Option<CoreHandle>,
+    },
+    Projected {
+        paints: std::vec::IntoIter<CoreHandle>,
+        world: Mat2D,
+    },
+}
+
+impl<'a> ClipPaints<'a> {
+    fn new(owner: &'a CoreHandle) -> Option<Self> {
+        owner
+            .with(|object| {
+                let native = (object as &dyn std::any::Any).is::<Shape>();
+                let shape = object.as_shape()?;
+                let paints = shape.paint_container.shape_paints();
+                Some(if native {
+                    Self::Native {
+                        owner,
+                        count: paints.len(),
+                        index: 0,
+                        first: paints.first().cloned(),
+                    }
+                } else {
+                    Self::Projected {
+                        paints: paints.to_vec().into_iter(),
+                        world: *shape.base.world_transform(),
+                    }
+                })
+            })
+            .flatten()
+    }
+
+    fn next(&mut self) -> Option<CoreHandle> {
+        match self {
+            Self::Native {
+                owner,
+                count,
+                index,
+                first,
+            } => {
+                if *index >= *count {
+                    return None;
+                }
+                let current = *index;
+                *index += 1;
+                if current == 0 {
+                    first.take()
+                } else {
+                    owner
+                        .with(|object| {
+                            object
+                                .as_shape()?
+                                .paint_container
+                                .shape_paints()
+                                .get(current)
+                                .cloned()
+                        })
+                        .flatten()
+                }
+            }
+            Self::Projected { paints, .. } => paints.next(),
+        }
+    }
+
+    fn world(&self) -> Option<Mat2D> {
+        match self {
+            Self::Native { owner, .. } => owner
+                .with(|object| object.as_shape().map(|shape| *shape.base.world_transform()))
+                .flatten(),
+            Self::Projected { world, .. } => Some(*world),
+        }
+    }
+}
 
