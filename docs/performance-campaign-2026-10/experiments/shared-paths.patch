+#[derive(Default)]
+struct Query {
+    calls: Cell<usize>,
+    action: RefCell<Option<(usize, Box<dyn FnOnce()>)>>,
+}
+impl Query {
+    fn arm(&self, after: usize, f: impl FnOnce() + 'static) {
+        *self.action.borrow_mut() = Some((self.calls.get() + after, Box::new(f)));
+    }
+    fn run(&self) {
+        let next = self.calls.get() + 1;
+        self.calls.set(next);
+        let action = {
+            let mut action = self.action.borrow_mut();
+            if action.as_ref().is_some_and(|(when, _)| *when == next) {
+                action.take()
+            } else {
+                None
+            }
+        };
+        if let Some((_, action)) = action {
+            action();
+        }
+    }
+}
