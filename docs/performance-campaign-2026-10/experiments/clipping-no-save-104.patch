+use super::*;
+use crate::mechanical_port::source::{
+    core::{CoreArena, CoreObject, CoreType},
+    generated::core_registry::component_update_handle,
+    math::vec2d::Vec2D,
+    shapes::{
+        paint::{
+            stroke::Stroke,
+            stroke_effect::{EffectPath, StrokeEffect},
+            trim_path::TrimPath,
+        },
+        points_path::PointsPath,
+        shape::Shape,
+    },
+};
+use std::{
+    cell::Cell,
+    panic::{AssertUnwindSafe, catch_unwind},
+};
+
+struct CallbackPath {
+    callback: Box<dyn FnMut()>,
+    path: Option<Rc<RefCell<ShapePaintPath>>>,
+}
+impl EffectPath for CallbackPath {
+    fn path(&mut self) -> Option<Rc<RefCell<ShapePaintPath>>> {
+        (self.callback)();
+        self.path.clone()
+    }
+}
+fn geometry(local: bool, x: f32) -> Rc<RefCell<ShapePaintPath>> {
+    let mut p = ShapePaintPath::new(local);
+    p.mutable_raw_path().move_to(x, 0.0);
+    p.mutable_raw_path().line_to(x + 2.0, 1.0);
+    Rc::new(RefCell::new(p))
+}
+fn source(arena: &CoreArena) -> CoreHandle {
+    let path = arena.insert(PointsPath::default());
+    let mut shape = Shape::default();
+    shape.add_path(path);
+    arena.insert(shape)
+}
+fn fill_with_effect(
+    arena: &CoreArena,
+    source: &CoreHandle,
+    callback: impl FnMut() + 'static,
+    path: Option<Rc<RefCell<ShapePaintPath>>>,
+) -> CoreHandle {
+    let fill = arena.insert(Fill::default());
+    let provider = fill
+        .with_downcast::<Fill, _>(|f| *f.base.base.path_provider())
+        .unwrap();
+    let mut effect = TrimPath::default();
+    effect.stroke_effect_state().add_path_provider(
+        &provider,
+        Box::new(CallbackPath {
+            callback: Box::new(callback),
+            path,
+        }),
+    );
+    let effect = arena.insert(effect);
+    fill.with_downcast_mut::<Fill, _>(|f| f.base.base.effects_container.effects.push(effect));
+    source.with_mut(|s| {
+        s.as_shape_mut()
+            .unwrap()
+            .paint_container
+            .add_paint(fill.clone())
+    });
+    fill
+}
+fn clip(arena: &CoreArena, source: &CoreHandle) -> CoreHandle {
+    let mut clip = ClippingShape::default();
+    clip.shapes.push(source.clone());
+    arena.insert(clip)
+}
+fn points(clip: &CoreHandle) -> Vec<Vec2D> {
+    clip.with_downcast::<ClippingShape, _>(|c| c.path.raw_path().points().to_vec())
+        .unwrap()
+}
