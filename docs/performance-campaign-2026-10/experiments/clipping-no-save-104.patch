+fn no_save_clip_does_not_follow_reused_slot_or_embedded_core_redirection() {
+    let arena = CoreArena::default();
+    let clip = arena.insert(ClippingShape::default());
+    let _root = hydrate_clip(&arena, &clip);
+    let other = arena.insert(ClippingShape::default());
+    clip.with_downcast_mut::<ClippingShape, _>(|clip| clip.core_mut().set_handle(other.clone()))
+        .unwrap();
+    let mut renderer = ClipCallback {
+        callback: Box::new(|| ()),
+        clips: 0,
+    };
+    let mut start = ClippingShapeStart {
+        clipping_shape: Some(clip.clone()),
+    };
+    start.draw(&mut renderer, false);
+    assert_eq!(
+        renderer.clips, 1,
+        "draw belongs to original occurrence, not embedded Core handle"
+    );
+    drop(arena.remove(&clip).unwrap());
+    let replacement = arena.insert(ClippingShape::default());
+    assert_eq!(replacement.identity_key().1, clip.identity_key().1);
+    assert_ne!(replacement.identity_key().2, clip.identity_key().2);
+    let _replacement_root = hydrate_clip(&arena, &replacement);
+    start.draw(&mut renderer, false);
+    assert_eq!(
+        renderer.clips, 1,
+        "stale operation cannot draw the reused slot"
+    );
+}
