  {
    "name": "overflow-nested-shape-relative-clip",
    "html": "<div id=frame><div id=outer><div id=host><div id=child></div></div><div id=side></div></div></div>",
    "css": "#frame{width:100%;padding:12px}#outer{width:75%;height:180px;padding:10px;border-radius:28px;background:#ece9f5;overflow:clip;position:relative}#host{width:80%;height:110px;margin-left:26px;position:relative;top:45px;border-radius:40px;background:#e9a344;overflow:clip;overflow:clip}#child{position:relative;left:60px;top:45px;width:180px;height:100px;z-index:10;background:#318ea8}#side{width:100px;height:65px;position:relative;left:50px;top:-45px;background:#897198;z-index:1}"
  },
