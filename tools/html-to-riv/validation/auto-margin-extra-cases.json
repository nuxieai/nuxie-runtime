    "html": "<div id=\"root\"><div id=\"basic\"><p id=\"btitle\">Basic</p><p id=\"bbody\">For small teams</p><p id=\"baction\">Choose</p></div><div id=\"pro\"><p id=\"ptitle\">Pro</p><p id=\"pbody\">Room for growing teams</p><p id=\"paction\">Choose</p></div></div>",
    "css": "#root{width:100%;padding:12px;gap:12px;flex-direction:row;flex-wrap:wrap;background:#eef}#basic,#pro{width:150px;height:140px;padding:8px;gap:6px;border-radius:8px;background:#cfd}#pro{background:#cef}p{font-size:12px;line-height:16px}#btitle,#ptitle{font-size:16px;line-height:20px}#baction,#paction{margin-top:auto;padding:6px;background:#ffc;border-radius:4px}"
