-- string library
local s = "Hello, World"
print(s:len(), s:upper(), s:lower(), s:reverse(), s:rep(2), s:rep(0), s:rep(-1), ("ab"):rep(3, "-"))
print(s:sub(1, 5), s:sub(-5), s:sub(3), s:sub(0), s:sub(5, 2), s:sub(-100, 100), s:sub(2, -2))
print(s:byte(), s:byte(-1), s:byte(1, 3), s:byte(100))
print(string.char(), string.char(97, 98, 99), pcall(string.char, 256))
print(s:find("World"), s:find("o"), s:find("o", 6), s:find("xyz"), s:find("l+"), s:find(".", 1, true))
print(s:find(""), s:find("", 100), s:find("", 13), ("a.b"):find(".", 2, true))
print(s:match("(%a+), (%a+)"), s:match("%d"), s:match("()ll()"), s:match("^Hello"), s:match("World$"))
print(("key = value"):match("^(%w+)%s*=%s*(%w+)$"))
print(("  trim me  "):match("^%s*(.-)%s*$"))
print(("2024-01-15"):match("(%d+)-(%d+)-(%d+)"))
print(("[[x]]"):match("%[%[(.-)%]%]"), ("f(a(b)c)"):match("%b()"), ("THE (quick) fox"):find("%f[%a]%a+", 5))
print(("hello world"):gsub("o", "0"))
print(("hello world"):gsub("(%w+)", "<%1>"))
print(("hello world"):gsub("%w+", "%0 %0", 1))
print(("abc"):gsub("", "-"))
print(("hello"):gsub("l", {l = "L"}))
print(("hello"):gsub(".", function(c) if c == "l" then return "1" end end))
print(("$name is $age"):gsub("%$(%w+)", {name = "Ann", age = 30}))
print(("abc"):gsub("%w", "%%"))
print(pcall(string.gsub, "abc", "(", "x"))
print(pcall(string.gsub, "abc", "%", "x"))
print(pcall(string.gsub, "abc", "a", "%2"))
print(pcall(string.find, "abc", "[a"))
print(pcall(string.rep, "x", 1e10))
print(("x"):rep(3), ("%d"):format(5))
print(("a,b,,c"):find(",", 1, true), ("a+b"):find("+", 1, true))
print(("CamelCaseString"):gsub("(%u)", " %1"))
print(("%a %c %d %g %l %p %s %u %w %x"):len(), ("A1 b2\t!"):gsub("%p", "P"))
print(("x"):byte(0), ("abc"):sub(2, 1) == "", ("\0a\0"):len(), ("a\0b"):upper())
print(string.format("%q", "line\nbreak\0zero\"quote\\"))
return s:upper()
