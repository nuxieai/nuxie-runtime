+#[test]
+fn each_effect_reads_world_after_its_callback() {
+    let arena = CoreArena::default();
+    let shape = source(&arena);
+    for tx in [10.0, 30.0] {
+        let target = shape.clone();
+        fill_with_effect(
+            &arena,
+            &shape,
+            move || {
+                target
+                    .with_mut(|s| {
+                        s.as_shape_mut()
+                            .unwrap()
+                            .base
+                            .set_world_transform(Mat2D::new(1.0, 0.0, 0.0, 1.0, tx, 0.0))
+                    })
+                    .unwrap();
+            },
+            Some(geometry(true, 1.0)),
+        );
+    }
+    let clip = clip(&arena, &shape);
+    assert!(component_update_handle(&clip, ComponentDirt::PATH));
+    assert_eq!(
+        points(&clip),
+        vec![
+            Vec2D::new(11.0, 0.0),
+            Vec2D::new(13.0, 1.0),
+            Vec2D::new(31.0, 0.0),
+            Vec2D::new(33.0, 1.0)
+        ]
+    );
+}
+
+#[test]
+fn occurrence_releases_clip_for_effect_and_preserves_world_effect_coordinates() {
+    let arena = CoreArena::default();
+    let shape = source(&arena);
+    let clip = clip(&arena, &shape);
+    let target = clip.clone();
+    let calls = Rc::new(Cell::new(0));
+    let observed = calls.clone();
+    fill_with_effect(
+        &arena,
+        &shape,
+        move || {
+            target
+                .with_downcast_mut::<ClippingShape, _>(|c| {
+                    assert!(!c.clip_path);
+                    assert!(c.path.empty());
+                    observed.set(observed.get() + 1);
+                })
+                .unwrap();
+        },
+        Some(geometry(false, 4.0)),
+    );
+    shape.with_mut(|s| {
+        s.as_shape_mut()
+            .unwrap()
+            .base
+            .set_world_transform(Mat2D::new(1.0, 0.0, 0.0, 1.0, 70.0, 0.0))
+    });
+    component_update_handle(&clip, ComponentDirt::WORLD_TRANSFORM);
+    assert_eq!(calls.get(), 1);
+    assert_eq!(
+        points(&clip),
+        vec![Vec2D::new(4.0, 0.0), Vec2D::new(6.0, 1.0)]
+    );
+}
