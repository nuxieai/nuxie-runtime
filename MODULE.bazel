module(name = "nuxie_runtime", version = "0.1.0")

bazel_dep(name = "rules_rust", version = "0.74.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "apple_support", version = "2.5.2")
bazel_dep(name = "rules_android_ndk", version = "0.1.5")

wasm_c = use_extension("//bazel:wasm-c-tools.bzl", "wasm_c_tools")
use_repo(wasm_c, "nuxie_wasm_c_tools")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    versions = ["1.94.1"],
    extra_target_triples = [
        "aarch64-apple-darwin",
        "x86_64-apple-darwin",
        "aarch64-apple-ios",
        "aarch64-apple-ios-sim",
        "x86_64-apple-ios",
        "aarch64-linux-android",
        "x86_64-linux-android",
        "wasm32-unknown-unknown",
    ],
)
use_repo(rust, "rust_toolchains")
register_toolchains("@rust_toolchains//:all")

ndk = use_extension("@rules_android_ndk//:extension.bzl", "android_ndk_repository_extension")
ndk.configure(api_level = 23)
use_repo(ndk, "androidndk")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.annotation(
    crate = "libhydrogen-sys",
    build_script_use_default_shell_env = "on",
)
crate.from_cargo(
    name = "runtime_crates",
    cargo_lockfile = "//bazel/cargo:Cargo.lock",
    lockfile = "//bazel/cargo:Cargo.Bazel.lock",
    manifests = ["//bazel/cargo:Cargo.toml"],
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-apple-ios",
        "aarch64-apple-ios-sim",
        "aarch64-linux-android",
        "aarch64-unknown-linux-gnu",
        "wasm32-unknown-unknown",
        "x86_64-apple-darwin",
        "x86_64-apple-ios",
        "x86_64-linux-android",
        "x86_64-pc-windows-msvc",
        "x86_64-unknown-linux-gnu",
    ],
)
use_repo(crate, "runtime_crates")

# Optional native tooling has a separate external feature closure. SDK targets
# continue to resolve through runtime_crates.
crate.from_cargo(
    name = "runtime_native_tools_crates",
    cargo_lockfile = "//bazel/native-tools-cargo:Cargo.lock",
    lockfile = "//bazel/native-tools-cargo:Cargo.Bazel.lock",
    manifests = ["//bazel/native-tools-cargo:Cargo.toml"],
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-apple-ios",
        "aarch64-apple-ios-sim",
        "aarch64-linux-android",
        "aarch64-unknown-linux-gnu",
        "wasm32-unknown-unknown",
        "x86_64-apple-darwin",
        "x86_64-apple-ios",
        "x86_64-linux-android",
        "x86_64-pc-windows-msvc",
        "x86_64-unknown-linux-gnu",
    ],
)
use_repo(crate, "runtime_native_tools_crates")
