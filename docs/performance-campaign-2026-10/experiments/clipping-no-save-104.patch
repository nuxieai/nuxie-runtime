+#[test]
+fn retired_clip_is_not_replaced_by_the_new_generation_during_effect_return() {
+    let arena = CoreArena::default();
+    let shape = source(&arena);
+    let clip = clip(&arena, &shape);
+    let target = clip.clone();
+    let current_arena = arena.clone();
+    let replacement = Rc::new(RefCell::new(None));
+    let out = replacement.clone();
+    fill_with_effect(
+        &arena,
+        &shape,
+        move || {
+            assert!(current_arena.remove(&target).is_some());
+            *out.borrow_mut() = Some(current_arena.insert(ClippingShape::default()));
+        },
+        Some(geometry(false, 4.0)),
+    );
+    component_update_handle(&clip, ComponentDirt::PATH);
+    assert!(!clip.is_alive());
+    let replacement = replacement.borrow();
+    let replacement = replacement.as_ref().unwrap();
+    assert!(
+        replacement
+            .with_downcast::<ClippingShape, _>(|c| c.path.empty() && !c.clip_path)
+            .unwrap()
+    );
+}
