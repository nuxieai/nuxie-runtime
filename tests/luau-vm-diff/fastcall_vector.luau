local B8 = buffer.create(8)
for byte = 0, 7 do buffer.writeu8(B8, byte, byte * 37 + 3) end
local seen, nseen = {}, 0
local function fmt(v)
    local t = type(v)
    if t == "string" then
        -- `tostring` of a table or function names its address.
        return string.format("%q", (string.gsub(v, ": 0x%x+", ": ADDR")))
    elseif t == "table" or t == "function" or t == "buffer" or t == "userdata" or t == "thread" then
        local id = seen[v]
        if not id then
            nseen += 1
            id = nseen
            seen[v] = id
        end
        return t .. "#" .. id
    end
    return tostring(v)
end
local function emit(label, ok, ...)
    local s = label .. (if ok then " ok" else " err")
    for arg = 1, select("#", ...) do
        s ..= " " .. fmt((select(arg, ...)))
    end
    print(s)
end
