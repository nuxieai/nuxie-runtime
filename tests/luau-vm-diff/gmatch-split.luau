-- string.gmatch and string.split
local function collect(it) local out = {} for a, b in it do out[#out + 1] = tostring(a) .. (b ~= nil and ("/" .. tostring(b)) or "") end return table.concat(out, " ") end
print(collect(string.gmatch("hello world from luau", "%a+")))
print(collect(string.gmatch("k1=v1, k2=v2,k3=v3", "(%w+)=(%w+)")))
print(collect(string.gmatch("abc", "")))
print(collect(string.gmatch("abc", "x*")))
print(collect(string.gmatch("^a^b", "^.")))
print(collect(string.gmatch("aXbXc", "()X")))
print(collect(string.gmatch("", ".")), collect(string.gmatch("", "")))
print(collect(("one two"):gmatch("%S+")))
print(collect(string.gmatch(12345, "%d%d")))
local it = string.gmatch("ab", ".")
print(it(), it(), it(), it())
local bad = string.gmatch("abc", "(")
print(pcall(bad))
print(pcall(string.gmatch, "abc"))
print(pcall(string.gmatch, {}, "a"))
print(pcall(string.gmatch("abc", "%"), nil))
local stateful = string.gmatch("a1b2c3", "%a(%d)")
print(stateful(), stateful())
local other = string.gmatch("a1b2c3", "%a(%d)")
print(other(), stateful(), other())
-- split
local function show(t) local p = {} for i = 1, #t do p[i] = "[" .. t[i] .. "]" end return #t .. ":" .. table.concat(p) end
print(show(string.split("a,b,,c")))
print(show(string.split("a,b,,c", ",")))
print(show(string.split("a--b----c", "--")))
print(show(string.split("abc", "")))
print(show(string.split("", "")))
print(show(string.split("")))
print(show(string.split("abc", "abcd")))
print(show(string.split("abc", "abc")))
print(show(string.split("aaa", "aa")))
print(show(string.split("x\0y\0z", "\0")))
print(show(("1 2 3"):split(" ")))
print(show(string.split(123.5, ".")))
print(pcall(string.split))
print(pcall(string.split, "a", {}))
return #string.split("a b c", " ")
