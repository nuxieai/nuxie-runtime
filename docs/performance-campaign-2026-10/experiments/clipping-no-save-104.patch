+fn hydrate_clip(arena: &CoreArena, clip: &CoreHandle) -> CoreHandle {
+    use crate::mechanical_port::source::{artboard::Artboard, factory::RuntimeFactoryHandle};
+    let mut factory = nuxie_render_api::PersistentFactory::new(nuxie_render_api::NullFactory);
+    let root = arena.insert(Artboard::with_factory(
+        RuntimeFactoryHandle::from_factory(&mut factory).unwrap(),
+    ));
+    let mut context = ClipContext {
+        arena: arena.weak_handle(),
+        root: root.clone(),
+    };
+    clip.with_downcast_mut::<ClippingShape, _>(|clip| {
+        assert_eq!(clip.base.on_added_dirty(&mut context), StatusCode::Ok);
+        clip.path.mutable_raw_path().move_to(1.0, 2.0);
+        clip.path.mutable_raw_path().line_to(3.0, 4.0);
+        clip.clip_path = true;
+    })
+    .unwrap();
+    root
+}
