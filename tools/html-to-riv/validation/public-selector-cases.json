  {
    "name": "selector-adjacent-comments-nesting",
    "html": "<div id=\"root\"><div id=\"r1\" class=\"start\"></div><!-- non-element -->\n<div id=\"r2\" class=\"target\"></div><div id=\"r3\" class=\"group\"><div id=\"r4\" class=\"target\"></div></div><div id=\"r5\" class=\"target\"></div></div>",
    "css": "#root{width:180px;height:112px;background:white}#root div{width:160px;height:16px;background:silver}#root .start + .target{background:teal}#root .group{height:32px;width:180px;background:navy}",
    "features": [
