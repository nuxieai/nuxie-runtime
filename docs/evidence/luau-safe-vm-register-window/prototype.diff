+    /// SCRATCH: the value slot of an existing, non-nil string key.
+    #[inline]
+    pub(crate) fn existing_str_mut(&mut self, key: StrId) -> Option<&mut Value> {
+        if self.readonly {
+            return None;
+        }
+        let i = self.find_str(key)?;
+        self.nodes.get_mut(i).map(|n| &mut n.val).filter(|v| !v.is_nil())
