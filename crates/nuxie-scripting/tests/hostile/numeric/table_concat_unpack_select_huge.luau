--! attacks: select("#")/select(n) with huge and negative n, table.unpack of huge ranges, table.concat over huge ranges and huge totals (memory last); expect: error(not enough memory); within: 20s
local LOG = {}
local function try(name, f, ...)
  local r = table.pack(pcall(f, ...))
  local err = tostring(r[2])
  assert(not string.find(err, "rust panic", 1, true), name .. ": " .. err)
  table.insert(LOG, name .. " => " .. tostring(r[1]) .. " " .. string.sub(err, 1, 120))
  return r[1], r[2], r
end
local function refused(name, f, ...)
  local ok, err = try(name, f, ...)
  assert(not ok, name .. ": accepted")
  return tostring(err)
end
local nan, inf = 0 / 0, math.huge
refused("unpack 1..1e8", table.unpack, {}, 1, 1e8)
refused("unpack 1..2^31", table.unpack, {}, 1, 2 ^ 31)
refused("unpack -2^31..2^31", table.unpack, {}, -(2 ^ 31), 2 ^ 31)
refused("unpack 1..2^53", table.unpack, {}, 1, 2 ^ 53)
try("unpack 2^53..1", table.unpack, {}, 2 ^ 53, 1)
try("unpack nan", table.unpack, {}, 1, nan)
try("unpack -inf..inf", table.unpack, {}, -inf, inf)
try("unpack 7999", table.unpack, {}, 1, 7999)
refused("unpack 9000", table.unpack, {}, 1, 9000)
assert(select("#") == 0)
refused("select 0", select, 0)
refused("select -1 of none", select, -1)
refused("select -2^31", select, -(2 ^ 31), 1, 2)
try("select 2^31", select, 2 ^ 31, 1, 2)
try("select 2^53", select, 2 ^ 53)
try("select nan", select, nan, 1)
try("select inf", select, inf, 1)
assert(select("#", table.unpack(table.create(7000, 1))) == 7000)
try("table.pack 7000", table.pack, table.unpack(table.create(7000, 1)))
refused("concat nil hole", table.concat, {}, ",", 1, 2 ^ 31)
refused("concat 1..2^53", table.concat, { "a" }, ",", 1, 2 ^ 53)
try("concat empty range", table.concat, {}, ",", 2 ^ 53, 1)
try("concat -2^31..-2^31+2", table.concat, {}, ",", -(2 ^ 31), -(2 ^ 31) + 2)
refused("concat table element", table.concat, { {} })
assert(#table.concat(table.create(10000, "x"), string.rep(",", 100)) == 10000 + 9999 * 100)
-- 200 MiB of separators: over the VM heap, terminal by design
local sep = string.rep(",", 1024 * 1024)
local s = table.concat(table.create(200, "x"), sep)
error("200 MiB concat was allocated: " .. #s)
